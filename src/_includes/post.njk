---
layout: base.njk
---
{% set related = collections.posts | byCategory(category, site.live) | exclude(page.url) %}
{% set items = content | toc %}
<article class="w post">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="{{ hubUrl }}">{{ category }}</a></li><li aria-current="page">{{ title }}</li></ol></nav>

<header class="post-head">
<p class="eye">{{ category }} · {{ type | capitalize }}</p>
<h1>{{ title }}</h1>
{% if description %}<p class="lead">{{ description }}</p>{% endif %}
<div class="byline">
<img class="avatar" src="/img/gupta-avatar.webp" width="48" height="48" alt="{{ site.editor.name }}" decoding="async">
<p><span class="who">{% if preview %}Awaiting medical review by{% else %}Medically reviewed by{% endif %} <b>{{ site.editor.name }}</b>, {{ site.editor.credentials }}</span><span class="meta"><time datetime="{{ (updated or date) | dateISO }}">Updated {{ (updated or date) | dateShort }}</time> · {{ content | readTime }} min read</span></p>
</div>
<p class="disclose">We may earn a commission if you buy through our links. It never changes our scores. <a href="/disclosure/">How we stay independent</a></p>
</header>

{% if preview %}<p class="sample"><b>Draft preview.</b> This page is awaiting review by {{ site.editor.name }} and is not yet published. Facts are from the sources listed at the end; nothing here has been tested by our team.</p>{% endif %}
{% if sample %}<p class="sample"><b>Sample only.</b> This page shows the layout of a finished {{ type }}. The names, scores and text are placeholders.</p>{% endif %}

{% if type == "review" %}
<section class="verdict" aria-label="{% if score %}Our verdict{% else %}Status{% endif %}">
{% if score %}<div class="vscore"><b>{{ score }}</b><small>/10</small><span>Our score</span></div>
{% else %}<div class="vscore"><span>Researched, not yet tested</span></div>{% endif %}
<div class="vbody">
<h2>{% if score %}The short version{% else %}Where this review stands{% endif %}</h2>
<p>{{ verdict }}</p>
<dl class="facts"><div><dt>Best for</dt><dd>{{ bestFor }}</dd></div><div><dt>Pricing</dt><dd>{{ pricing }}</dd></div></dl>
</div>
<div class="proscons">
<div><h3>{% if score %}What we liked{% else %}What stands out on paper{% endif %}</h3><ul class="pro">{% for i in pros %}<li>{{ i }}</li>{% endfor %}</ul></div>
<div><h3>{% if score %}What to know{% else %}What to check before you buy{% endif %}</h3><ul class="con">{% for i in cons %}<li>{{ i }}</li>{% endfor %}</ul></div>
</div>
{% if affiliateUrl %}<div class="vcta"><a class="btn t" href="{{ affiliateUrl }}" rel="sponsored nofollow noopener" target="_blank">Visit {{ tool }}<span class="sr"> (opens in a new tab)</span></a></div>
{% elif officialUrl %}<div class="vcta"><a class="btn s" href="{{ officialUrl }}" rel="nofollow noopener" target="_blank">{{ tool }} official site<span class="sr"> (opens in a new tab)</span></a></div>{% endif %}
</section>
{% endif %}

<div class="post-grid">
{% if items.length %}<aside class="toc"><nav aria-label="On this page"><details open><summary>On this page</summary><ol>{% for i in items %}<li><a href="#{{ i.id }}">{{ i.text }}</a></li>{% endfor %}</ol></details></nav></aside>{% endif %}
<div class="prose">
{{ content | safe }}
</div>
</div>

<section class="author" aria-labelledby="trust-h">
<span class="seal" aria-hidden="true"><svg width="44" height="44" style="color:var(--ink)"><use href="#logo"/></svg></span>
<div>
<p class="eye">Why you can trust this</p>
<h2 id="trust-h">Reviewed by {{ site.editor.name }}</h2>
<p>{{ site.editor.credentials }} · {{ site.editor.specialty }} · {{ site.editor.experience }}. {% if preview %}This draft has not been reviewed by him yet.{% else %}Every review is checked by him before it is published.{% endif %} <a href="/methodology/">See how we review</a></p>
</div>
</section>
</article>

{% if related.length %}
<section class="tight"><div class="w">
<div class="head"><div><p class="eye">Keep reading</p><h2>More in {{ category }}</h2></div></div>
<ul class="cards">
{% for p in related | head(3) %}<li><a class="cd" href="{{ p.url }}"><div class="im {{ p.data.tone or 'a' }}" role="img" aria-label="Article image"></div><span class="tag">{{ p.data.category }} · {{ p.data.type | capitalize }}</span><h3>{{ p.data.title }}</h3><p>{{ p.templateContent | readTime }} min read</p></a></li>{% endfor %}
</ul>
</div></section>
{% endif %}

{% include "newsletter.njk" %}
